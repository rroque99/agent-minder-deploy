# Lab 1 - Configure Environment Variables
#
# Copy to .env, edit, then `source .env` (or let scripts/lib/common.sh load it).
# These drive the release name, namespace and chart repo ONLY. Chart
# configuration lives in the values/ override files -- environment variables
# are NOT expanded inside those YAML files.

export PREFIX="myssp"
export DOMAIN="myiam.example.com"
export SSP_FQDN="${PREFIX}.${DOMAIN}"
export RELEASENAME="ssp"
export NAMESPACE="ssp"
export HELM_REPO='agentminder-charts'
export HELM_REPO_URL=https://ssp_helm_charts.storage.googleapis.com/agentminder-charts/

# --- Broadcom image registry (Lab 2) -----------------------------------------
# Credentials from the Broadcom Support Portal. Used to create the
# ssp-gcr-registry-creds pull secret referenced by every override file.
export BROADCOM_REGISTRY_SERVER="securityservices.packages.broadcom.com"
export BROADCOM_REGISTRY_USERNAME="<BROADCOM_REGISTRY_USERNAME>"
export BROADCOM_REGISTRY_TOKEN="<BROADCOM_REGISTRY_TOKEN>"

# --- Pod Security Admission (Labs 2-4) ---------------------------------------
# PSA level (enforce/audit/warn) applied to every namespace these scripts
# create: $NAMESPACE, envoy-gateway-system, logging, monitoring.
# AgentMinder's workloads need more than 'restricted' permits.
# privileged | baseline | restricted
export PSA_LEVEL="privileged"

# --- Gateway API (Labs 3-4) --------------------------------------------------
export GATEWAY_CLASS="eg"
# The Gateway the enclave HTTPRoutes attach to (Kibana/Grafana, script 04b).
#
# Leave GATEWAY_NAME empty to auto-discover it: 04b looks in
# $GATEWAY_NAMESPACE first, then cluster-wide, and narrows by $GATEWAY_CLASS if
# several turn up. In demo mode the ssp chart creates the Gateway in Lab 6 and
# picks the name, so there is nothing useful to set here in advance.
#
# Set it only to pin a specific Gateway - e.g. a shared edge Gateway, or when
# discovery reports more than one candidate.
export GATEWAY_NAME=""
export GATEWAY_NAMESPACE="${NAMESPACE}"

# --- Chart versions ----------------------------------------------------------
# Optional: pin AgentMinder chart versions (empty = latest).
export AGENTMINDER_CHART_VERSION=""
export ENVOY_GATEWAY_VERSION="v1.8.1"
export ECK_OPERATOR_VERSION="3.2.0"
export KUBE_PROMETHEUS_VERSION="11.3.10"
export GRAFANA_OPERATOR_VERSION="4.9.37"

# --- Platform profile --------------------------------------------------------
# demo | production -- selects values/ssp-override.<profile>.yaml
export SSP_PROFILE="demo"

# AgentMinder deployment - the ONLY file you edit.
#
#   cp .env.example .env && $EDITOR .env
#
# Everything in values/ is a template (*.yaml.tpl) rendered from these values
# into .rendered/ at install time. Never edit values/ or .rendered/ directly -
# the next run overwrites .rendered/, and a values template should get its
# environment-specific data from here.
#
# Values that cannot be known up front (marked DISCOVERED below) are written
# back into this file automatically by the script that finds them.

# =============================================================================
# Identity & placement                                              (Lab 1)
# =============================================================================
export PREFIX="myssp"
export DOMAIN="myiam.example.com"
export SSP_FQDN="${PREFIX}.${DOMAIN}"
export RELEASENAME="ssp"
export NAMESPACE="ssp"

# Hostname for the optional Sample App / MCP Playground (Lab 9).
export SAMPLE_APP_FQDN="sampleapp-${PREFIX}.${DOMAIN}"

# =============================================================================
# Helm chart repository                                             (Lab 2)
# =============================================================================
export HELM_REPO='agentminder-charts'
export HELM_REPO_URL=https://ssp_helm_charts.storage.googleapis.com/agentminder-charts/
# Pin chart versions; empty = latest.
#
# The platform charts (ssp, ssp-infra, ssp-sample-app, ssp-aigateway) share a
# version, e.g. 4.1.0+1578 -- check with:
#     helm search repo "$HELM_REPO/ssp" --versions
export AGENTMINDER_CHART_VERSION=""
#
# ssp-data is on its own series (the weekly risk/network data release, e.g.
# 2026.26), so it is pinned separately and never inherits the value above.
export SSP_DATA_CHART_VERSION=""

# =============================================================================
# Broadcom image registry                                           (Lab 2)
# =============================================================================
# Credentials from the Broadcom Support Portal.
export BROADCOM_REGISTRY_SERVER="securityservices.packages.broadcom.com"
export BROADCOM_REGISTRY_USERNAME="<BROADCOM_REGISTRY_USERNAME>"
export BROADCOM_REGISTRY_TOKEN="<BROADCOM_REGISTRY_TOKEN>"
# Name of the pull secret created in the install namespace and referenced by
# every chart. Change only if you mirror images - see docs/private-registry.md.
export REGISTRY_SECRET_NAME="ssp-gcr-registry-creds"

# =============================================================================
# Pod Security Admission                                            (Labs 2-4)
# =============================================================================
# Applied to every namespace these scripts create: $NAMESPACE,
# envoy-gateway-system, logging, monitoring.
# privileged | baseline | restricted
export PSA_LEVEL="privileged"

# =============================================================================
# Gateway API                                                       (Labs 3-4)
# =============================================================================
export GATEWAY_CLASS="eg"
export ENVOY_GATEWAY_VERSION="v1.8.1"

# DISCOVERED (Lab 6) - the Gateway the enclave HTTPRoutes attach to. The ssp
# chart names the Gateway it creates, so leave these empty: 04b discovers them
# and writes them back here. Set them only to pin a shared edge Gateway.
export GATEWAY_NAME=""
export GATEWAY_NAMESPACE=""

# DISCOVERED (Lab 4) - Grafana service name, for the Grafana HTTPRoute.
export GRAFANA_SERVICE=""

# =============================================================================
# Enclave services - observability & monitoring                     (Lab 4)
# =============================================================================
export ECK_OPERATOR_VERSION="3.2.0"
export KUBE_PROMETHEUS_VERSION="11.3.10"
export GRAFANA_OPERATOR_VERSION="4.9.37"

export ES_VERSION="9.2.1"
export ES_NODE_COUNT="1"          # demo: 1  |  production: 3
export ES_STORAGE="20Gi"          # size to retention, e.g. 1 GB/day x 90 = 90Gi

# Where Fluent Bit ships platform logs.
export ELASTIC_HOST="elasticsearch-es-http.logging.svc"
export ELASTIC_PORT="9200"
export ELASTIC_USER="elastic"
# DISCOVERED (Lab 4) - read from the elasticsearch-es-elastic-user secret and
# written back here, because it does not exist until Elasticsearch is up.
# Using your own Elasticsearch? Set it (and ELASTIC_HOST/USER) yourself.
export ELASTIC_PASSWORD=""

# =============================================================================
# Platform profile                                                  (Lab 6)
# =============================================================================
# demo | production - selects values/ssp-override.<profile>.yaml.tpl
export SSP_PROFILE="demo"

export SSP_DEPLOYMENT_SIZE="demo"     # demo | small | medium | large
export OBSERVE_ENABLED="true"         # AgentMinder observability pipeline
export NATS_ENABLED="true"            # NATS JetStream - required by observability
export CLICKHOUSE_ENABLED="true"      # ClickHouse - required by observability
export AIGATEWAY_ENABLED="true"       # in-platform (central) AI Gateway
export OTEL_ACCEPT_EXTERNAL="true"    # accept external OTLP

# TLS secret for the ingress/Gateway listener. Demo can leave the default.
export TLS_SECRET_NAME="ssp-general-tls"

# =============================================================================
# Production only                                    (SSP_PROFILE=production)
# =============================================================================
# Ignored on the demo profile.
export IMAGE_REPOSITORY_BASE="<registry-base>/"
export USE_IMAGE_DIGEST="true"
export EXISTING_GATEWAY="enterprise-gateway"
export MTLS_ENABLED="false"

# External database - see docs/database-connectivity.md
export DB_TYPE="mysql"                # mysql | postgresql | oracle
export DB_HOST="<db-host>"
export DB_PORT="3306"                 # postgresql 5432 - oracle 1521 (SSL 2484)
export DB_SCHEMA="iamauth"
export DB_USER="iamauth"
export DB_SECRET="ssp-db-credentials" # k8s secret; key: mysql-password
export DB_SSL_MODE="VERIFY_CA"        # REQUIRED | VERIFY_CA | VERIFY_IDENTITY
export DB_JDBC_URL="jdbc:${DB_TYPE}://${DB_HOST}:${DB_PORT}/${DB_SCHEMA}"

# =============================================================================
# Sample App & MCP Playground - optional                            (Lab 9)
# =============================================================================
# The Playground creates agents via GCP Vertex AI.
export GCP_PROJECT_ID="<your-gcp-project-id>"
export GCP_REGION="global"
# Secret holding the service-account key; "" to use Workload Identity.
export GCP_SA_KEY_SECRET=""
# Path to a service-account key JSON; set to have script 09 create the secret.
export GCP_SA_KEY_FILE=""

# =============================================================================
# External AI Gateway - optional                                    (Lab 11)
# =============================================================================
export AIGW_FQDN="aigateway.${DOMAIN}"
export AIGW_GROUP_ID="<gateway-group-uuid>"   # Admin Console -> AI Gateways
export IDSP_BASE_URL="https://${SSP_FQDN}/default"
export AIGW_SCOPES="urn:iam:myscopes"
export AIGW_CREDENTIALS_SECRET="${RELEASENAME}-aigateway-credentials"
export AIGW_TLS_SELF_SIGNED="true"            # dev/test only
# Platform Client credentials from Gateway Group -> General Settings.
export AIGW_CLIENT_ID=""
export AIGW_CLIENT_SECRET=""
